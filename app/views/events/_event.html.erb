<div id="<%= dom_id event %>">
  <div>
    <strong>Schedule:</strong>
    <%= event.schedule_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= event.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= event.description %>
  </div>

  <div>
    <strong>Start time:</strong>
    <%= event.start_time %>
  </div>

  <div>
    <strong>End time:</strong>
    <%= event.end_time %>
  </div>

</div>
